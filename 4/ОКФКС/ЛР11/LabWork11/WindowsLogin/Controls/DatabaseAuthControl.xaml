<UserControl x:Class="WindowsLogin.DatabaseAuthControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:WindowsLogin"
             Height="400" Width="500">
    <StackPanel Margin="20">
        <TextBlock Text="Аутентификация через БД (пароли)" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

        <TabControl>
            <TabItem Header="Регистрация">
                <StackPanel Margin="10">
                    <TextBlock Text="Имя пользователя:" Margin="0,0,0,5"/>
                    <TextBox x:Name="RegUsername" Height="25" Margin="0,0,0,10"/>

                    <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="RegPassword" Height="25" Margin="0,0,0,10"/>

                    <TextBlock Text="Роль:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="RegRole" Height="25" Margin="0,0,0,20">
                        <ComboBoxItem Content="Admin" IsSelected="True"/>
                        <ComboBoxItem Content="Moderator"/>
                        <ComboBoxItem Content="User"/>
                    </ComboBox>

                    <Button Content="Зарегистрировать" Click="RegisterButton_Click" 
                            Height="30" Width="120"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Вход">
                <StackPanel Margin="10">
                    <TextBlock Text="Имя пользователя:" Margin="0,0,0,5"/>
                    <TextBox x:Name="LoginUsername" Height="25" Margin="0,0,0,10"/>

                    <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="LoginPassword" Height="25" Margin="0,0,0,20"/>

                    <Button Content="Войти" Click="LoginButton_Click" 
                            Height="30" Width="120"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="DbAuthResult" Margin="0,20,0,0" FontWeight="Bold"/>
    </StackPanel>
</UserControl>